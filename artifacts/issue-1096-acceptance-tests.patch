diff --git a/scripts/run_adjudicator_acceptance.js b/scripts/run_adjudicator_acceptance.js
new file mode 100644
index 0000000..5f95b7e
--- /dev/null
+++ b/scripts/run_adjudicator_acceptance.js
@@ -0,0 +1,155 @@
+'use strict';
+
+// Repository-local test evidence only. This never dispatches or authenticates
+// a deployment, native receipt, canonical grade, or live cohort.
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { createHash } = require('node:crypto');
+const { spawnSync } = require('node:child_process');
+const { parseArgs } = require('node:util');
+
+const namedTests = [
+  'test_build_packet_includes_diff_and_acceptance_criteria',
+  'test_adjudicator_validator_accepts_recommendation_prose',
+  'test_floor_still_demotes_a_metadata_only_packet',
+  'test_abstained_row_is_reattempted_when_the_packet_gains_diff_and_criteria',
+];
+const sourcePaths = ['src', 'tests', 'pyproject.toml', 'requirements.lock'];
+const junitReader = `
+import json, sys, xml.etree.ElementTree as ET
+root = ET.parse(sys.argv[1]).getroot()
+print(json.dumps([{"name": c.get("name"), "classname": c.get("classname"),
+    "unsuccessful": any(e.tag in ("failure", "error", "skipped") for e in c)}
+    for c in root.iter("testcase")]))
+`;
+
+function digest(bytes) {
+  return createHash('sha256').update(bytes).digest('hex');
+}
+
+function execute(command, args, { cwd, env = process.env, timeout = 60000 }) {
+  // Some automation runners prohibit child-process pipes. Keep complete output
+  // in files rather than a bounded in-memory spawnSync buffer.
+  const temporary = fs.mkdtempSync(path.join(os.tmpdir(), 'retro-check-io-'));
+  const descriptors = ['stdout', 'stderr'].map((name) =>
+    fs.openSync(path.join(temporary, name), 'w'));
+  try {
+    const result = spawnSync(command, args, {
+      cwd, env, timeout, stdio: ['ignore', ...descriptors],
+    });
+    return { exit_code: result.status, signal: result.signal,
+      error_code: result.error?.code ?? null,
+      stdout: fs.readFileSync(path.join(temporary, 'stdout')),
+      stderr: fs.readFileSync(path.join(temporary, 'stderr')) };
+  } finally {
+    descriptors.forEach((fd) => fs.closeSync(fd));
+    fs.rmSync(temporary, { recursive: true, force: true });
+  }
+}
+
+function git(root, args) {
+  const result = execute('git', args, { cwd: root,
+    env: { ...process.env, GIT_NO_REPLACE_OBJECTS: '1' } });
+  if (result.exit_code !== 0 || result.error_code) throw new Error('Git source check failed');
+  return result.stdout.toString('utf8').trimEnd();
+}
+
+function snapshot(root, revision) {
+  if (git(root, ['rev-parse', 'HEAD']) !== revision) throw new Error('Checkout revision mismatch');
+  // Include fixtures and configuration as well as Python: tests import and read
+  // both. Refuse uncommitted inputs instead of labelling them as revision bytes.
+  git(root, ['diff', '--quiet', revision, '--', ...sourcePaths]);
+  if (git(root, ['ls-files', '--others', '--exclude-standard', '--', ...sourcePaths])) {
+    throw new Error('Untracked acceptance inputs');
+  }
+  const files = git(root, ['ls-files', '-z', '--', ...sourcePaths]).split('\0').filter(Boolean);
+  return Object.fromEntries(files.map((file) => [file, digest(fs.readFileSync(path.join(root, file)))]));
+}
+
+function runAcceptance({ root = path.resolve(__dirname, '..'), python, revision, output,
+  timeout = 60000 }) {
+  if (!path.isAbsolute(python || '')) throw new Error('Select an absolute Python interpreter');
+  if (!/^[a-f0-9]{40}$/.test(revision || '')) throw new Error('Select a full source revision');
+  if (!Number.isSafeInteger(timeout) || timeout < 1 || timeout > 60000) {
+    throw new Error('Timeout must be between 1 and 60000 milliseconds');
+  }
+  if (!output || !path.isAbsolute(output)) throw new Error('Select an absolute new output directory');
+  const before = snapshot(root, revision);
+  fs.mkdirSync(output); // Exclusive: never replace a prior run's receipts.
+  const state = fs.mkdtempSync(path.join(os.tmpdir(), 'retro-check-state-'));
+  const env = { ...process.env, PYTEST_DISABLE_PLUGIN_AUTOLOAD: '1',
+    ORCH_STATE_DIR: state, ORCH_CAPABILITIES_PATH: path.join(state, 'capabilities.json') };
+  delete env.PYTEST_ADDOPTS;
+  const receipt = { schema_version: 1, checked_at: new Date().toISOString(),
+    evaluated_revision: revision, evaluated_tree: git(root, ['rev-parse', `${revision}^{tree}`]),
+    accepted_deployment_verified: false, interpreter: python,
+    runner_sha256: digest(fs.readFileSync(__filename)),
+    input_manifest_sha256: digest(JSON.stringify(before)), input_file_count: Object.keys(before).length,
+    source_sha256: Object.fromEntries(Object.entries(before).filter(([file]) => [
+      'src/adjudicator_retro.py', 'src/roles.py', 'src/feedback.py', 'src/capability_advisor.py',
+      'src/verifier_evidence.py', 'tests/test_adjudicator_retro.py', 'pyproject.toml',
+    ].includes(file))),
+    checks: [], source_unchanged: false, required_tests_passed: false };
+  try {
+    const version = execute(python, ['--version'], { cwd: root, env, timeout });
+    receipt.interpreter_version = Buffer.concat([version.stdout, version.stderr]).toString().trim();
+    receipt.interpreter_usable = version.exit_code === 0 && !version.error_code && !version.signal;
+    for (const [name, nodes] of [
+      ['named-tests', namedTests.map((test) => `tests/test_adjudicator_retro.py::${test}`)],
+      ['retrospective-suite', ['tests/test_adjudicator_retro.py']],
+    ]) {
+      const xml = path.join(output, `${name}.xml`);
+      const command = [python, '-m', 'pytest', '-o', 'addopts=', '-m', 'not slow', '-q',
+        `--junitxml=${xml}`, ...nodes];
+      const result = execute(python, command.slice(1), { cwd: root, env, timeout });
+      const log = Buffer.concat([result.stdout, result.stderr]);
+      fs.writeFileSync(path.join(output, `${name}.log`), log, { flag: 'wx' });
+      let cases = null;
+      if (fs.existsSync(xml)) {
+        const parsed = execute(python, ['-I', '-c', junitReader, xml], { cwd: root, env, timeout });
+        if (parsed.exit_code === 0 && !parsed.error_code) {
+          try { cases = JSON.parse(parsed.stdout.toString()); } catch { /* Invalid receipt. */ }
+        }
+      }
+      const complete = Array.isArray(cases) && cases.length > 0 &&
+        cases.every((item) => !item.unsuccessful && item.classname === 'tests.test_adjudicator_retro') &&
+        namedTests.every((test) => cases.filter((item) => item.name === test).length === 1) &&
+        (name !== 'named-tests' || cases.length === namedTests.length);
+      receipt.checks.push({ name, command, exit_code: result.exit_code, signal: result.signal,
+        error_code: result.error_code, timed_out: result.error_code === 'ETIMEDOUT',
+        log: `${name}.log`, log_sha256: digest(log),
+        junit: fs.existsSync(xml) ? `${name}.xml` : null,
+        junit_sha256: fs.existsSync(xml) ? digest(fs.readFileSync(xml)) : null,
+        test_count: Array.isArray(cases) ? cases.length : null,
+        passed: result.exit_code === 0 && !result.error_code && !result.signal && complete });
+    }
+    try { receipt.source_unchanged = JSON.stringify(snapshot(root, revision)) === JSON.stringify(before); }
+    catch { receipt.source_unchanged = false; }
+    receipt.required_tests_passed = receipt.interpreter_usable && receipt.source_unchanged &&
+      receipt.checks.every((item) => item.passed);
+    receipt.finished_at = new Date().toISOString();
+    fs.writeFileSync(path.join(output, 'checks.json'), `${JSON.stringify(receipt, null, 2)}\n`, { flag: 'wx' });
+    return receipt;
+  } finally {
+    fs.rmSync(state, { recursive: true, force: true });
+  }
+}
+
+if (require.main === module) {
+  try {
+    const { values } = parseArgs({ options: { python: { type: 'string' },
+      revision: { type: 'string' }, output: { type: 'string' }, timeout: { type: 'string' } } });
+    const receipt = runAcceptance({ ...values,
+      timeout: values.timeout === undefined ? 60000 : Number(values.timeout) });
+    process.stdout.write(`${JSON.stringify({ required_tests_passed: receipt.required_tests_passed,
+      accepted_deployment_verified: false, checks: receipt.checks.map(({ name, exit_code, passed }) =>
+        ({ name, exit_code, passed })) })}\n`);
+    process.exitCode = receipt.required_tests_passed ? 0 : 1;
+  } catch (error) {
+    process.stderr.write(`${error.message}\n`);
+    process.exitCode = 2;
+  }
+}
+
+module.exports = { execute, namedTests, runAcceptance };
diff --git a/tests/test_adjudicator_acceptance_runner.js b/tests/test_adjudicator_acceptance_runner.js
new file mode 100644
index 0000000..e01dd69
--- /dev/null
+++ b/tests/test_adjudicator_acceptance_runner.js
@@ -0,0 +1,148 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { createHash } = require('node:crypto');
+const { test } = require('node:test');
+const { execute, namedTests, runAcceptance } = require('../scripts/run_adjudicator_acceptance');
+
+function fixture(t, scenario = {}) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'retro-acceptance-test-'));
+  t.after(() => fs.rmSync(root, { recursive: true, force: true }));
+  function git(...args) {
+    const result = execute('git', args, { cwd: root });
+    assert.equal(result.exit_code, 0, result.stderr.toString());
+    return result.stdout.toString().trim();
+  }
+  for (const directory of ['src', 'tests']) fs.mkdirSync(path.join(root, directory));
+  for (const file of ['src/adjudicator_retro.py', 'tests/test_adjudicator_retro.py', 'pyproject.toml']) {
+    fs.writeFileSync(path.join(root, file), '# fixture\n');
+  }
+  git('init', '-q');
+  git('add', 'src', 'tests', 'pyproject.toml');
+  git('-c', 'user.name=Acceptance test', '-c', 'user.email=acceptance@example.invalid',
+    'commit', '-qm', 'fixture');
+  const revision = git('rev-parse', 'HEAD');
+  // A selected-interpreter double, never a substitute for running real pytest.
+  const python = path.join(root, 'interpreter');
+  fs.writeFileSync(python, `#!${process.execPath}
+const fs = require('node:fs');
+const path = require('node:path');
+const args = process.argv.slice(2);
+const options = ${JSON.stringify(scenario)};
+const required = ${JSON.stringify(namedTests)};
+if (args[0] === '--version') { console.log('Python fixture'); process.exit(0); }
+if (args[0] === '-I') {
+  const { spawnSync } = require('node:child_process');
+  const result = spawnSync(${JSON.stringify(process.env.PYTHON || '/opt/hostedtoolcache/Python/3.14.9/x64/bin/python')}, args,
+    { stdio: 'inherit' });
+  process.exit(result.status ?? 1);
+}
+fs.appendFileSync(path.join(__dirname, 'calls.jsonl'), JSON.stringify(args) + '\\n');
+if (options.timeout) { setTimeout(() => {}, 10000); }
+else if (options.missing) { console.error('No module named pytest'); process.exit(1); }
+else {
+  const full = !args.some((arg) => arg.includes('::'));
+  let names = full ? [...required, 'test_extra'] : required;
+  if (options.incomplete) names = names.slice(1);
+  if (options.empty) names = [];
+  if (options.duplicate) names = [...names, names[0]];
+  const cases = names.map((name) => '<testcase name="' + name + '" classname="' +
+    (options.foreign ? 'tests.test_unrelated' : 'tests.test_adjudicator_retro') + '">' +
+    (options.skipped && full ? '<skipped />' : '') + '</testcase>').join('');
+  const xml = args.find((arg) => arg.startsWith('--junitxml=')).slice('--junitxml='.length);
+  if (!options.noXml) fs.writeFileSync(xml, options.malformed ? '<broken' : '<testsuites><testsuite>' + cases + '</testsuite></testsuites>');
+  if (options.mutate) fs.appendFileSync(path.join(__dirname, 'src/adjudicator_retro.py'), '# changed\\n');
+  console.log('fixture stdout'); console.error('fixture stderr');
+  process.exit(options.exit ?? 0);
+}
+`, { mode: 0o700 });
+  return { root, python, revision, output: path.join(root, 'receipt'), timeout: 10000 };
+}
+
+test('records exact commands, source hashes, complete JUnit and logs for both checks', (t) => {
+  const options = fixture(t);
+  const receipt = runAcceptance(options);
+  assert.equal(receipt.required_tests_passed, true);
+  assert.equal(receipt.accepted_deployment_verified, false);
+  assert.equal(receipt.source_unchanged, true);
+  assert.equal(receipt.evaluated_revision, options.revision);
+  assert.equal(receipt.interpreter, options.python);
+  assert.deepEqual(receipt.checks.map((item) => item.test_count), [4, 5]);
+  assert.equal(Object.keys(receipt.source_sha256).length, 3);
+  for (const item of receipt.checks) {
+    const calls = fs.readFileSync(path.join(options.root, 'calls.jsonl'), 'utf8')
+      .trim().split('\n').map(JSON.parse);
+    assert.deepEqual(item.command.slice(1), calls[receipt.checks.indexOf(item)]);
+    assert.ok(item.command.includes('not slow'));
+    const log = fs.readFileSync(path.join(options.output, item.log));
+    assert.match(log.toString(), /fixture stdout\nfixture stderr/);
+    assert.equal(item.log_sha256, createHash('sha256').update(log).digest('hex'));
+    const xml = fs.readFileSync(path.join(options.output, item.junit));
+    assert.equal(item.junit_sha256, createHash('sha256').update(xml).digest('hex'));
+  }
+  assert.deepEqual(JSON.parse(fs.readFileSync(path.join(options.output, 'checks.json'))), receipt);
+});
+
+test('missing pytest preserves two failures and cannot complete acceptance', (t) => {
+  const options = fixture(t, { missing: true });
+  const receipt = runAcceptance(options);
+  assert.equal(receipt.required_tests_passed, false);
+  assert.equal(receipt.source_unchanged, true);
+  for (const item of receipt.checks) {
+    assert.equal(item.exit_code, 1);
+    assert.equal(item.test_count, null);
+    assert.equal(item.junit, null);
+    assert.match(fs.readFileSync(path.join(options.output, item.log), 'utf8'), /No module named pytest/);
+  }
+});
+
+for (const scenario of [{ noXml: true }, { malformed: true }, { empty: true },
+  { incomplete: true }, { duplicate: true }, { skipped: true }, { foreign: true }, { exit: 1 }]) {
+  test(`refuses a successful claim for incomplete evidence: ${JSON.stringify(scenario)}`, (t) => {
+    const receipt = runAcceptance(fixture(t, scenario));
+    assert.equal(receipt.required_tests_passed, false);
+  });
+}
+
+test('source changes during execution invalidate otherwise passing checks', (t) => {
+  const receipt = runAcceptance(fixture(t, { mutate: true }));
+  assert.ok(receipt.checks.every((item) => item.passed));
+  assert.equal(receipt.source_unchanged, false);
+  assert.equal(receipt.required_tests_passed, false);
+});
+
+test('timeout preserves both failed checks without retrying either command', (t) => {
+  const options = fixture(t, { timeout: true });
+  const receipt = runAcceptance({ ...options, timeout: 500 });
+  assert.equal(receipt.checks.length, 2);
+  assert.ok(receipt.checks.every((item) => item.timed_out && !item.passed));
+  assert.equal(receipt.required_tests_passed, false);
+  assert.equal(fs.readFileSync(path.join(options.root, 'calls.jsonl'), 'utf8').trim().split('\n').length, 2);
+});
+
+test('refuses revision mismatch, modified tracked inputs and untracked inputs before execution', (t) => {
+  const options = fixture(t);
+  assert.throws(() => runAcceptance({ ...options, revision: 'a'.repeat(40) }), /revision mismatch/);
+  fs.writeFileSync(path.join(options.root, 'tests', 'extra.py'), '# untracked\n');
+  assert.throws(() => runAcceptance(options), /Untracked/);
+  fs.unlinkSync(path.join(options.root, 'tests', 'extra.py'));
+  fs.appendFileSync(path.join(options.root, 'src', 'adjudicator_retro.py'), '# changed\n');
+  assert.throws(() => runAcceptance(options), /Git source check failed/);
+  assert.equal(fs.existsSync(options.output), false);
+  assert.equal(fs.existsSync(path.join(options.root, 'calls.jsonl')), false);
+});
+
+test('requires explicit interpreter/revision/bounds and never overwrites a receipt', (t) => {
+  const options = fixture(t, { missing: true });
+  for (const change of [{ python: 'python' }, { revision: 'HEAD' }, { timeout: 0 },
+    { timeout: 60001 }, { output: 'relative' }]) {
+    assert.throws(() => runAcceptance({ ...options, ...change }));
+  }
+  runAcceptance(options);
+  const before = fs.readFileSync(path.join(options.output, 'checks.json'));
+  assert.throws(() => runAcceptance(options), /EEXIST/);
+  assert.deepEqual(fs.readFileSync(path.join(options.output, 'checks.json')), before);
+});
