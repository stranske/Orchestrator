   const exit = /^backend exit=(-?\d+)(?: [^\r\n]*)?$/.exec(value);
@@ -83,10 +99,10 @@ function firstRetainedBreak(fields, conflict = false) {
   if (conflict || fields.some((item) => !item.classification)) {
     return { status: 'unresolved', ...empty };
